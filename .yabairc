sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

# kinda annoying but maybe necessary for focus / throwing
yabai -m config mouse_follows_focus          on  
yabai -m config focus_follows_mouse          off
yabai -m config window_placement             second_child
yabai -m config window_origin_display        focused
yabai -m config window_topmost               off
yabai -m config window_shadow                on
yabai -m config window_opacity               on
yabai -m config window_opacity_duration      0.0
yabai -m config active_window_opacity        1.0
yabai -m config normal_window_opacity        0.95
# seems to be broken with big sur?
yabai -m config window_border                off  
yabai -m config window_border_width          6
# yabai -m config window_border_radius         5
yabai -m config active_window_border_color   0xffa35763
yabai -m config normal_window_border_color   0xff353c54

yabai -m config insert_feedback_color        0xaa7c5c9c
yabai -m config split_ratio                  0.50
yabai -m config auto_balance                 off
yabai -m config mouse_modifier               fn
yabai -m config mouse_action1                move
yabai -m config mouse_action2                resize

#yabai -m config window_animation_duration    0.5
#yabai -m config window_animation_frame_rate  120

# general space settings
yabai -m config layout                       bsp
yabai -m config top_padding                  10
# special top padding for monitor
yabai -m config --space 11 top_padding       40
yabai -m config bottom_padding               10
yabai -m config left_padding                 10
yabai -m config right_padding                10
yabai -m config window_gap                   5
yabai -m config --space 11 window_gap        10


# doesn't work
# yabai -m config mouse_modifier               fn

# external bar (hack to get space only on big monitor, but maintain logical
# space numbers)
# yabai -m config external_bar main:-20:0

# ignore calendar.app popup
yabai -m rule --add app="Calendar" \
      title!="Calendar" manage=off
yabai -m rule --add app="Skim" \
      title="^Anchored Note(.*)|General|Display|Notes|Sync" manage=off
yabai -m rule --add app="^System Preferences$" manage=off
yabai -m rule --add app="^IINA" manage=off
yabai -m rule --add app="^Stickies" manage=off
yabai -m rule --add app="^Stats" manage=off mouse_follows_focus=off
yabai -m rule --add app="^Calculator" manage=off
yabai -m rule --add app="^Simulator" manage=off

# Float Playwright-launched Chrome windows (identified by ms-playwright in process args)
yabai -m signal --add event=window_created app="^Google Chrome$" \
      action='PID=$(yabai -m query --windows --window $YABAI_WINDOW_ID | python3 -c "import json,sys; print(json.load(sys.stdin)[\"pid\"])") && ps -p $PID -o args= | grep -q "ms-playwright" && yabai -m window $YABAI_WINDOW_ID --toggle float'

# Force iTerm windows to open on focused display (workaround for window_origin_display not working)
yabai -m signal --add event=window_created app="^iTerm2$" action="yabai -m window \$YABAI_WINDOW_ID --display mouse && yabai -m window --focus \$YABAI_WINDOW_ID"

